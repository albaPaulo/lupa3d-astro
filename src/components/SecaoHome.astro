---
import ProductCard from "./ProductCard.astro";

const { secao, produtos, badgesPorId } = Astro.props;
const grade = secao.layout === "grade";
const estiloGrade = grade ? `--secao-colunas: ${secao.colunas || 4};` : "";
const classeSecao = `secao-home${secao.neutro ? " secao-home--neutro" : ""}`;
const estilo = secao.neutro ? estiloGrade : `--cor-secao: ${secao.cor}; ${estiloGrade}`;
---
<section class={classeSecao} style={estilo}>
  <div class="secao-cabecalho">
    <div class="secao-cabecalho-titulos">
      <h2 class="secao-titulo">
        {secao.icone && <span class="secao-titulo-selo" aria-hidden="true">{secao.icone}</span>}
        {secao.nome}
      </h2>
      {secao.descricao && <p class="secao-descricao">{secao.descricao}</p>}
    </div>
    {secao.verMaisHref && <a href={secao.verMaisHref} class="secao-ver-mais">Ver mais &rarr;</a>}
  </div>
  <div class={grade ? "secao-grade" : "secao-scroll"}>
    {produtos.map((p) => (
      <ProductCard
        p={p}
        menorPreco={badgesPorId.get(p.id)?.menorPreco}
        produtoNovo={badgesPorId.get(p.id)?.produtoNovo}
        precoAnterior={badgesPorId.get(p.id)?.precoAnterior}
      />
    ))}
  </div>
</section>
