---
import { formatarPreco, materialEfetivo, kitEfetivo, EMOJI_CATEGORIA, normalizarBusca, otimizarImagem } from "../lib/supabase.js";

const { p, menorPreco = null, produtoNovo = null, precoAnterior = null } = Astro.props;
const material = materialEfetivo(p) || "";
const kit = kitEfetivo(p);
const temPix = p.preco_pix != null && Number(p.preco_pix) < Number(p.preco);
---
<article
  class="card"
  data-id={p.id}
  data-href={`/produto/${p.id}/`}
  data-nome={normalizarBusca(p.nome)}
  data-categoria={p.categoria || ""}
  data-material={material}
  data-loja={p.loja}
  data-pix={temPix ? "1" : "0"}
  data-preco={p.preco}
  data-cliques={p.cliques_total || 0}
  data-criado={p.criado_em || ""}
>
  <button class="btn-favorito" data-id={p.id} title="Favoritar" aria-label="Favoritar" aria-pressed="false">☆</button>
  {p.destaque && <span class="badge-destaque">🔥</span>}
  {kit && <span class="badge-kit">Kit/Combo</span>}
  {p.afiliado && <span class="badge-afiliado" title="Link de afiliado — o LUPA3D pode receber uma comissão nessa compra, sem custo extra pra você">Afiliado</span>}
  {menorPreco && <span class="badge-menor-preco">{menorPreco.icone ? `${menorPreco.icone} ` : ""}{menorPreco.label || `Menor preço em ${menorPreco.dias} dias`}</span>}
  {produtoNovo && <span class="badge-produto-novo">{produtoNovo.icone ? `${produtoNovo.icone} ` : ""}{produtoNovo.label || "Novo"}</span>}
  <div class="card-imagem">
    {p.imagem_url ? (
      <img src={otimizarImagem(p.imagem_url, 400)} alt={p.nome} loading="lazy" referrerpolicy="no-referrer" />
    ) : (
      <span class="card-imagem-vazia">{EMOJI_CATEGORIA[p.categoria] || "📦"}</span>
    )}
  </div>
  <div class="card-corpo">
    <h3 class="card-nome">{p.nome}</h3>
    <div class="card-precos">
      {precoAnterior && <span class="card-preco-anterior">{formatarPreco(precoAnterior)}</span>}
      <span class="card-preco">{formatarPreco(p.preco)}</span>
      {temPix && <span class="card-preco-pix">{formatarPreco(p.preco_pix)} no Pix</span>}
    </div>
    <div class="card-loja-linha">
      <span class="card-loja-monograma" aria-hidden="true">{(p.loja || "?").charAt(0).toUpperCase()}</span>
      <span class="card-loja-nome">{p.loja}</span>
    </div>
    <div class="card-acoes">
      <a href={`/produto/${p.id}/`} class="btn-ver-oferta">Ver detalhes</a>
      <button type="button" class="btn-comparar-toggle" data-id={p.id} title="Comparar" aria-label="Comparar" aria-pressed="false">⇄</button>
    </div>
  </div>
</article>
