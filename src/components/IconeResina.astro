---
// Ícone de frasco de resina — a cor vem de `color` no elemento pai
// (currentColor), então um componente só serve pra todos os materiais.
// `id` só existe pra dar um sufixo único aos gradientes/filtro quando a
// mesma página renderiza vários frascos (um id de <defs> repetido faz
// os SVGs seguintes "roubarem" a cor do primeiro).
interface Props {
  id: string;
  class?: string;
}
const { id, class: className } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" role="img" aria-hidden="true" class={className}>
  <defs>
    <linearGradient id={`bottle-${id}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#293344"/>
      <stop offset=".45" stop-color="#111722"/>
      <stop offset="1" stop-color="#05080d"/>
    </linearGradient>
    <linearGradient id={`label-${id}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="currentColor"/>
      <stop offset="1" stop-color="currentColor" stop-opacity=".62"/>
    </linearGradient>
    <linearGradient id={`resin-${id}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="currentColor" stop-opacity=".55"/>
      <stop offset=".55" stop-color="currentColor"/>
      <stop offset="1" stop-color="currentColor" stop-opacity=".72"/>
    </linearGradient>
    <filter id={`shadow-${id}`} x="-30%" y="-30%" width="160%" height="170%">
      <feDropShadow dx="0" dy="3" stdDeviation="3" flood-opacity=".22"/>
    </filter>
  </defs>

  <ellipse cx="61" cy="119" rx="48" ry="6" fill="#000" opacity=".12"/>

  <g filter={`url(#shadow-${id})`}>
    <path d="M22 30
             L22 19 Q22 14 27 13
             L58 13 Q63 14 63 19
             L63 30
             L69 37 Q72 41 72 48
             L72 103 Q72 112 64 116
             L18 116 Q10 112 10 103
             L10 48 Q10 41 13 37Z"
          fill={`url(#bottle-${id})`} stroke="#384354" stroke-width="1.4"/>

    <rect x="20" y="7" width="45" height="16" rx="5"
          fill="#111722" stroke="#4b5563" stroke-width="1.5"/>
    <g stroke="#667085" stroke-width="1.2" opacity=".8">
      <path d="M25 9v12"/><path d="M31 8v14"/><path d="M37 8v14"/>
      <path d="M43 8v14"/><path d="M49 8v14"/><path d="M55 8v14"/>
      <path d="M61 9v12"/>
    </g>
    <rect x="17" y="22" width="51" height="7" rx="2.5"
          fill="#0b1018" stroke="#465162" stroke-width="1"/>

    <path d="M17 43 Q14 49 14 61 V92"
          fill="none" stroke="#fff" stroke-width="2.2" opacity=".22" stroke-linecap="round"/>

    <rect x="17" y="48" width="48" height="42" rx="5"
          fill={`url(#label-${id})`} stroke="currentColor" stroke-opacity=".8" stroke-width="1"/>
    <path d="M17 72 Q41 67 65 72 V90 H17Z" fill="#07101c" opacity=".62"/>

    <path d="M41 55
             C41 55 33 65 33 69
             C33 74 36.6 77 41 77
             C45.4 77 49 74 49 69
             C49 65 41 55 41 55Z"
          fill="white" opacity=".96"/>
    <path d="M39 61 C37 64 36 66 36 68"
          fill="none" stroke="currentColor" stroke-width="1.5"
          stroke-linecap="round" opacity=".7"/>

    <text x="41" y="85" text-anchor="middle"
          font-family="Arial, Helvetica, sans-serif"
          font-size="7" font-weight="800" fill="white"
          letter-spacing=".35">RESINA</text>
  </g>

  <g transform="translate(76 68)">
    <circle cx="22" cy="-24" r="17" fill="#111827"
            stroke="currentColor" stroke-width="2.2"/>
    <circle cx="22" cy="-24" r="14" fill="currentColor" opacity=".18"/>

    <path d="M22 -34 C22 -34 16 -27 16 -23
             C16 -19.5 18.7 -17 22 -17
             C25.3 -17 28 -19.5 28 -23
             C28 -27 22 -34 22 -34Z"
          fill="currentColor"/>
    <path d="M20 -28 C19 -26 18.5 -24.5 18.5 -23"
          fill="none" stroke="white" stroke-width="1.4"
          stroke-linecap="round" opacity=".8"/>

    <path d="M10 8 L14 3 L18 7 L22 1 L26 7 L31 4 L35 9
             L35 17 L10 17Z"
          fill={`url(#resin-${id})`} stroke="currentColor" stroke-width="1"/>
    <path d="M15 17V24 M21 17V25 M28 17V24 M34 17V23"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".75"/>
    <rect x="8" y="24" width="30" height="4" rx="1.5"
          fill="#111827" stroke="#4b5563" stroke-width="1"/>
  </g>
</svg>
