---
import { formatarPreco, otimizarImagem } from "../lib/supabase.js";

const { p } = Astro.props;
---
<div class="parecido-item" data-id={p.id} data-href={`/produto/${p.id}/`}>
  {p.imagem_url ? (
    <img src={otimizarImagem(p.imagem_url, 80)} alt="" class="parecido-imagem" loading="lazy" referrerpolicy="no-referrer" />
  ) : (
    <span class="parecido-imagem parecido-imagem-vazia"></span>
  )}
  <span class="parecido-loja">{p.loja}</span>
  <span class="parecido-nome">{p.nome}</span>
  <span class="parecido-preco">{formatarPreco(p.preco)}</span>
  <button type="button" class="btn-comparar-toggle" data-id={p.id} title="Comparar" aria-label="Comparar" aria-pressed="false">⇄</button>
  <span class="parecido-seta">&rarr;</span>
</div>
