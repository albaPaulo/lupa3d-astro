---
// Ícone de carretel de filamento — a cor vem de `color` no elemento pai
// (currentColor), então um componente só serve pra todos os materiais.
// `id` só existe pra dar um sufixo único aos gradientes/filtro quando a
// mesma página renderiza vários carretéis (um id de <defs> repetido faz
// os SVGs seguintes "roubarem" a cor do primeiro).
interface Props {
  id: string;
  class?: string;
}
const { id, class: className } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" role="img" aria-hidden="true" class={className}>
  <defs>
    <linearGradient id={`spool-${id}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="currentColor" stop-opacity=".98"/>
      <stop offset="55%" stop-color="currentColor" stop-opacity=".82"/>
      <stop offset="100%" stop-color="currentColor" stop-opacity=".62"/>
    </linearGradient>
    <linearGradient id={`rim-${id}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#263142"/>
      <stop offset="100%" stop-color="#080c13"/>
    </linearGradient>
    <filter id={`shadow-${id}`} x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-opacity=".22"/>
    </filter>
  </defs>

  <ellipse cx="65" cy="108" rx="40" ry="7" fill="#000" opacity=".12"/>

  <g filter={`url(#shadow-${id})`}>
    <path d="M35 31 C25 38 20 51 20 67 C20 83 25 96 35 102
             C45 108 63 109 76 103 C88 97 94 84 94 67
             C94 50 88 38 76 31 C64 24 47 24 35 31Z"
          fill={`url(#spool-${id})`}/>

    <g fill="none" stroke="currentColor" stroke-linecap="round">
      <path d="M28 42 C22 57 22 78 29 92" stroke-width="3" opacity=".55"/>
      <path d="M33 36 C27 51 27 84 34 98" stroke-width="2.5" opacity=".75"/>
      <path d="M39 32 C34 50 34 87 40 103" stroke-width="2" opacity=".55"/>
      <path d="M45 29 C41 48 41 91 46 105" stroke-width="2" opacity=".8"/>
      <path d="M52 28 C49 47 49 93 52 106" stroke-width="2" opacity=".55"/>
      <path d="M59 28 C57 48 57 94 58 106" stroke-width="2" opacity=".75"/>
      <path d="M66 29 C65 48 65 93 64 105" stroke-width="2" opacity=".5"/>
      <path d="M73 32 C73 51 73 88 70 103" stroke-width="2" opacity=".7"/>
      <path d="M80 36 C81 54 80 84 76 98" stroke-width="2" opacity=".5"/>
    </g>

    <ellipse cx="78" cy="67" rx="28" ry="39" fill={`url(#rim-${id})`} stroke="#374151" stroke-width="2"/>
    <ellipse cx="78" cy="67" rx="17" ry="25" fill="#111827" stroke="#596579" stroke-width="2"/>
    <ellipse cx="78" cy="67" rx="9" ry="13" fill="#05080d" stroke="#657083" stroke-width="2"/>

    <g stroke="#4b5563" stroke-width="2" opacity=".9">
      <path d="M78 42 L78 54"/>
      <path d="M95 48 L87 57"/>
      <path d="M104 67 L91 67"/>
      <path d="M95 86 L87 78"/>
      <path d="M78 92 L78 80"/>
      <path d="M61 86 L69 78"/>
      <path d="M52 67 L65 67"/>
      <path d="M61 48 L69 57"/>
    </g>

    <g transform="translate(78 72)">
      <path d="M7 0 L24 6 L24 25 L7 31 L-10 25 L-10 6Z" fill="currentColor" opacity=".92"/>
      <path d="M7 0 L24 6 L7 12 L-10 6Z" fill="currentColor"/>
      <path d="M7 12 L24 6 L24 25 L7 31Z" fill="currentColor" opacity=".72"/>
      <path d="M7 12 L-10 6 L-10 25 L7 31Z" fill="currentColor" opacity=".58"/>
    </g>
  </g>
</svg>
