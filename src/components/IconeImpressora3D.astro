---
// Ícone de impressora 3D (silhueta FDM: estrutura + bandeja + peça sendo
// impressa) — não existe emoji de impressora 3D no Unicode, só o de
// impressora de escritório (🖨️), que não comunica a categoria direito.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" role="img" aria-hidden="true" class={className}>
  <ellipse cx="64" cy="118" rx="42" ry="6" fill="#000" opacity=".1"/>

  <!-- estrutura -->
  <rect x="18" y="98" width="92" height="12" rx="4" fill="#374151"/>
  <rect x="24" y="20" width="10" height="84" rx="3" fill="#4b5563"/>
  <rect x="94" y="20" width="10" height="84" rx="3" fill="#4b5563"/>
  <rect x="18" y="14" width="92" height="12" rx="4" fill="#374151"/>

  <!-- bandeja de impressão -->
  <rect x="38" y="84" width="52" height="8" rx="2" fill="#9ca3af"/>
  <rect x="38" y="84" width="52" height="3" fill="#d1d5db"/>

  <!-- extrusora, descendo da barra superior -->
  <rect x="56" y="26" width="4" height="20" fill="#6b7280"/>
  <rect x="49" y="44" width="18" height="12" rx="2" fill="#1f2937"/>
  <path d="M55 56 L61 56 L58 62 Z" fill="#111827"/>

  <!-- peça sendo impressa (camadas coloridas em construção) -->
  <g>
    <rect x="47" y="76" width="24" height="8" fill="#2563eb"/>
    <rect x="49" y="68" width="20" height="8" fill="#3b82f6"/>
    <rect x="51" y="60" width="16" height="8" fill="#60a5fa"/>
  </g>
</svg>
