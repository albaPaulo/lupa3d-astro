<div id="barra-comparacao" class="barra-comparacao">
  <span><span id="contador-comparacao">0</span> selecionados</span>
  <button id="btn-comparar" class="principal">Comparar</button>
  <button id="btn-compartilhar-comparacao" class="secundario">🔗 Compartilhar</button>
  <button id="btn-limpar-comparacao" class="secundario">Limpar</button>
</div>

<div id="modal-comparacao" class="modal">
  <div class="modal-caixa">
    <button id="modal-fechar" class="modal-fechar" aria-label="Fechar">✕</button>
    <div id="modal-comparacao-conteudo"></div>
    <button id="btn-print-comparacao" type="button" class="btn-print-comparacao">📷 Salvar imagem</button>
  </div>
</div>

<script>
  // Componente único compartilhado por ~10 páginas. A lib html-to-image só é
  // buscada (import dinâmico) quando o botão é clicado — assim ela nunca
  // entra na cadeia de carregamento crítico da página, só quem usa a função
  // paga o custo dela.
  document.getElementById("btn-print-comparacao")?.addEventListener("click", async (ev) => {
    const btn = ev.currentTarget;
    const alvo = document.getElementById("modal-comparacao-conteudo");
    if (!alvo) return;

    const textoOriginal = btn.textContent;
    btn.disabled = true;
    btn.textContent = "Gerando imagem...";

    try {
      const { toPng } = await import("html-to-image");
      const corFundo = getComputedStyle(document.documentElement).getPropertyValue("--cor-card").trim() || "#ffffff";
      const dataUrl = await toPng(alvo, { backgroundColor: corFundo, pixelRatio: 2 });
      const link = document.createElement("a");
      link.download = "comparacao-lupa3d.png";
      link.href = dataUrl;
      link.click();
    } catch (e) {
      console.error("Falha ao gerar imagem da comparação:", e);
      alert("Não foi possível gerar a imagem agora — tente de novo em alguns segundos.");
    } finally {
      btn.disabled = false;
      btn.textContent = textoOriginal;
    }
  });
</script>
