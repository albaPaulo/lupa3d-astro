---
// CSS global embutido direto no HTML (em vez de <link rel="stylesheet">
// externo) — remove a requisição de rede que o PageSpeed acusa como
// "bloqueando a renderização" sem trocar o tipo de carregamento (continua
// síncrono/na ordem certa), então não causa o flash-sem-estilo/troca de
// layout que a tentativa anterior com preload+swap causou.
import fs from "node:fs";
import path from "node:path";

const css = fs.readFileSync(path.join(process.cwd(), "public/css/style.css"), "utf-8");
---
<script is:inline>
  // Roda antes do CSS pintar a tela — evita o "flash" de tema errado que
  // aconteceria se essa troca só acontecesse depois, num script com defer.
  (function () {
    try {
      var tema = localStorage.getItem("lupa3d_tema");
      if (tema === "claro" || tema === "escuro") document.documentElement.dataset.tema = tema;
    } catch {}
  })();
</script>
<style set:html={css}></style>

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#2563eb" />

<script is:inline>
  // Registra o Service Worker (só existe pra habilitar "Adicionar à tela
  // inicial" — veja o comentário em /sw.js). Roda depois do load pra não
  // competir com o carregamento da página, e falha em silêncio em navegador
  // sem suporte (Service Worker é opcional, não é requisito pro site funcionar).
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", () => {
      navigator.serviceWorker.register("/sw.js").catch(() => {});
    });
  }
</script>
