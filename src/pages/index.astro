---
import BarraComparacao from "../components/BarraComparacao.astro";
import SecaoHome from "../components/SecaoHome.astro";
import Footer from "../components/Footer.astro";
import FaixaProvaSocial from "../components/FaixaProvaSocial.astro";
import GlobalStyles from "../components/GlobalStyles.astro";
import { fetchProdutos, fetchHistoricoTodos, fetchConfiguracoes, fetchSecoes, buildHistoricoPorProduto, EMOJI_CATEGORIA, LABEL_CATEGORIA } from "../lib/supabase.js";
import { badgesMenorPrecoDeConfig, badgesProdutoNovoDeConfig, badgeMenorPrecoEfetivo, badgeProdutoNovo, precoAnteriorParaExibicao } from "../lib/badges.js";
import { computarProdutosDaSecao } from "../lib/secoes.js";

const [produtos, historicoTodos, config, secoesRaw] = await Promise.all([
  fetchProdutos(),
  fetchHistoricoTodos(),
  fetchConfiguracoes(),
  fetchSecoes(),
]);
const historicoPorProduto = buildHistoricoPorProduto(historicoTodos);
const badgesMenorPreco = badgesMenorPrecoDeConfig(config);
const badgesProdutoNovo = badgesProdutoNovoDeConfig(config);
const historicoAtivo = config.menor_preco_historico_ativo !== "false";
const badgesPorId = new Map(
  produtos.map((p) => [
    p.id,
    {
      menorPreco: badgeMenorPrecoEfetivo(p, badgesMenorPreco, historicoPorProduto, historicoAtivo),
      produtoNovo: badgeProdutoNovo(p, badgesProdutoNovo),
      precoAnterior: precoAnteriorParaExibicao(p, historicoPorProduto),
    },
  ])
);

const secoes = secoesRaw
  .map((secao) => ({ secao, ...computarProdutosDaSecao(secao, produtos, historicoPorProduto) }))
  .filter(({ produtos: p }) => p.length > 0);

// Seções fixas, sempre presentes independente de configuração no admin —
// diferente da grade completa que a home tinha antes (todo o catálogo
// despejado no HTML, escondido por CSS até "Ver mais"), aqui só entra no
// HTML o que realmente aparece na tela. Isso é o que mais pesa no tamanho
// da página, e só piora conforme o catálogo cresce.
const LIMITE_SECAO_PADRAO = 5;
const secoesPadrao = [
  {
    nome: "Mais clicados",
    icone: "🔥",
    verMaisHref: "/mais-clicados/",
    produtos: [...produtos]
      .filter((p) => (p.cliques_total || 0) > 0)
      .sort((a, b) => (b.cliques_total || 0) - (a.cliques_total || 0))
      .slice(0, LIMITE_SECAO_PADRAO),
  },
  {
    nome: "Maiores quedas de preço",
    icone: "📉",
    verMaisHref: "/ofertas/",
    // Mesmo cálculo do feed.xml (percentual sobre precoAnterior real, não o
    // badge "menor preço" que é trivialmente verdadeiro sem histórico).
    produtos: produtos
      .filter((p) => badgesPorId.get(p.id)?.precoAnterior != null)
      .sort((a, b) => {
        const descontoA = 1 - Number(a.preco) / badgesPorId.get(a.id).precoAnterior;
        const descontoB = 1 - Number(b.preco) / badgesPorId.get(b.id).precoAnterior;
        return descontoB - descontoA;
      })
      .slice(0, LIMITE_SECAO_PADRAO),
  },
  {
    nome: "Novidades",
    icone: "🆕",
    verMaisHref: "/novidades/",
    produtos: [...produtos]
      .filter((p) => p.criado_em)
      .sort((a, b) => new Date(b.criado_em) - new Date(a.criado_em))
      .slice(0, LIMITE_SECAO_PADRAO),
  },
  {
    nome: "Menor preço recente",
    icone: "💸",
    produtos: produtos.filter((p) => badgesPorId.get(p.id)?.menorPreco).slice(0, LIMITE_SECAO_PADRAO),
  },
  // Seção incompleta (menos de 5 produtos) fica torta na grade de 5 colunas —
  // melhor sumir do que mostrar 1-2 cards soltos.
].filter((s) => s.produtos.length >= LIMITE_SECAO_PADRAO);

const categorias = [...new Set(produtos.map((p) => p.categoria).filter(Boolean))].sort();
const totalLojas = new Set(produtos.map((p) => p.loja)).size;

const tituloPagina = config.titulo_site || "LUPA3D — Comparador de preços de filamento e resina 3D";
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloPagina}</title>
  <meta name="description" content="Compare preços de filamentos e resinas 3D de várias lojas brasileiras num só lugar. Favoritos, comparação e histórico de preço, sem cadastro." />
  <link rel="canonical" href="https://lupa3d.com.br/" />
  <link rel="alternate" type="application/rss+xml" title="LUPA3D — Quedas de preço" href="/feed.xml" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="LUPA3D" />
  <meta property="og:title" content="LUPA3D — Comparador de preços de filamento e resina 3D" />
  <meta property="og:description" content="Compare preços de filamentos e resinas 3D de várias lojas brasileiras num só lugar. Favoritos, comparação e histórico de preço, sem cadastro." />
  <meta name="twitter:card" content="summary_large_image" />

  <GlobalStyles />
</head>
<body>
  <div id="banner-aviso" class="banner-aviso oculto-tela"></div>

  <header class="topo">
    <div class="topo-linha">
      <a href="/" class="logo-lupa3d">LUPA<span>3D</span></a>
      <nav class="abas">
        <a href="/ofertas/">🔥 Ofertas</a>
        <a href="/favoritos/">Favoritos (<span data-contador-favoritos>0</span>)</a>
        <a href="/lojas/">Lojas</a>
      </nav>
    </div>
  </header>

  <section class="barra-busca-categoria">
    <h1 class="hero-titulo">Compare preços de filamento e resina 3D entre várias lojas.</h1>

    <nav class="atalhos-categoria" aria-label="Atalhos de categoria">
      {categorias.map((c) => (
        <a href={`/categoria/${c}/`} class="atalho-categoria">
          <span class="atalho-categoria-icone" aria-hidden="true">{EMOJI_CATEGORIA[c] || "📦"}</span>
          <span class="atalho-categoria-label">{LABEL_CATEGORIA[c] || c}</span>
        </a>
      ))}
    </nav>

    <div class="busca-solo">
      <div class="busca-grande">
        <span class="busca-icone" aria-hidden="true">🔍</span>
        <input
          type="search"
          id="busca"
          placeholder="Pesquisar produto..."
          aria-label="Buscar produtos"
          autocomplete="off"
          data-busca-destino={categorias.length > 0 ? `/categoria/${categorias[0]}/` : "/categoria/"}
          data-categorias={categorias.join(",")}
        />
        <div id="busca-sugestoes" class="busca-sugestoes oculto-tela"></div>
      </div>
    </div>

    <p class="hero-subtitulo">Compare modelos, veja o histórico de preço e escolha onde comprar mais barato — sem cadastro.</p>
  </section>

  <FaixaProvaSocial totalProdutos={produtos.length} totalLojas={totalLojas} />

  <main>
    {secoesPadrao.map((s) => (
      <SecaoHome
        secao={{ nome: s.nome, icone: s.icone, neutro: true, layout: "grade", colunas: LIMITE_SECAO_PADRAO, verMaisHref: s.verMaisHref }}
        produtos={s.produtos}
        badgesPorId={badgesPorId}
      />
    ))}

    {secoes.map(({ secao, produtos: produtosDaSecao }) => (
      <SecaoHome secao={secao} produtos={produtosDaSecao} badgesPorId={badgesPorId} />
    ))}
  </main>

  <Footer />

  <BarraComparacao />

  <script is:inline defer src="/js/config.js"></script>
  <script is:inline defer src="/js/favoritos.js"></script>
  <script is:inline defer src="/js/interativo.js"></script>
</body>
</html>
