---
import ProductCard from "../components/ProductCard.astro";
import BarraComparacao from "../components/BarraComparacao.astro";
import SecaoHome from "../components/SecaoHome.astro";
import Footer from "../components/Footer.astro";
import FaixaProvaSocial from "../components/FaixaProvaSocial.astro";
import { fetchProdutos, fetchHistoricoTodos, fetchConfiguracoes, fetchSecoes, buildHistoricoPorProduto, materialEfetivo, EMOJI_CATEGORIA, LABEL_CATEGORIA } from "../lib/supabase.js";
import { badgesMenorPrecoDeConfig, badgesProdutoNovoDeConfig, badgeMenorPreco, badgeProdutoNovo, precoAnteriorParaExibicao } from "../lib/badges.js";
import { computarProdutosDaSecao } from "../lib/secoes.js";

const [produtos, historicoTodos, config, secoesRaw] = await Promise.all([
  fetchProdutos(),
  fetchHistoricoTodos(),
  fetchConfiguracoes(),
  fetchSecoes(),
]);
const historicoPorProduto = buildHistoricoPorProduto(historicoTodos);
const badgesMenorPreco = badgesMenorPrecoDeConfig(config);
const badgesProdutoNovo = badgesProdutoNovoDeConfig(config);
const colunasGrid = Math.min(6, Math.max(2, parseInt(config.colunas_grid, 10) || 3));
const badgesPorId = new Map(
  produtos.map((p) => [
    p.id,
    {
      menorPreco: badgeMenorPreco(p, badgesMenorPreco, historicoPorProduto),
      produtoNovo: badgeProdutoNovo(p, badgesProdutoNovo),
      precoAnterior: precoAnteriorParaExibicao(p, historicoPorProduto),
    },
  ])
);

const secoes = secoesRaw
  .map((secao) => ({ secao, ...computarProdutosDaSecao(secao, produtos, historicoPorProduto) }))
  .filter(({ produtos: p }) => p.length > 0);

const categorias = [...new Set(produtos.map((p) => p.categoria).filter(Boolean))].sort();
const materiais = [...new Set(produtos.map(materialEfetivo).filter(Boolean))].sort();
const totalLojas = new Set(produtos.map((p) => p.loja)).size;

const tituloPagina = config.titulo_site || "LUPA3D — Comparador de preços de filamento e resina 3D";
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloPagina}</title>
  <meta name="description" content="Compare preços de filamentos e resinas 3D de várias lojas brasileiras num só lugar. Favoritos, comparação e histórico de preço, sem cadastro." />
  <link rel="canonical" href="https://lupa3d.com.br/" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="LUPA3D" />
  <meta property="og:title" content="LUPA3D — Comparador de preços de filamento e resina 3D" />
  <meta property="og:description" content="Compare preços de filamentos e resinas 3D de várias lojas brasileiras num só lugar. Favoritos, comparação e histórico de preço, sem cadastro." />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preload" href="/css/style.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="/css/style.css" /></noscript>
</head>
<body>
  <div id="banner-aviso" class="banner-aviso oculto-tela"></div>

  <header class="topo">
    <div class="topo-linha">
      <a href="/" class="logo-lupa3d">LUPA<span>3D</span></a>
      <nav class="abas">
        <a href="/favoritos/">Favoritos (<span data-contador-favoritos>0</span>)</a>
        <a href="/lojas/">Lojas</a>
      </nav>
    </div>
  </header>

  <section class="barra-busca-categoria">
    <h1 class="hero-titulo">Compare preços de filamento e resina 3D entre várias lojas.</h1>

    <nav class="atalhos-categoria" aria-label="Atalhos de categoria">
      {categorias.map((c) => (
        <a href={`/categoria/${c}/`} class="atalho-categoria">
          <span class="atalho-categoria-icone" aria-hidden="true">{EMOJI_CATEGORIA[c] || "📦"}</span>
          <span class="atalho-categoria-label">{LABEL_CATEGORIA[c] || c}</span>
        </a>
      ))}
    </nav>

    <div class="busca-solo">
      <div class="busca-grande">
        <span class="busca-icone" aria-hidden="true">🔍</span>
        <input type="search" id="busca" placeholder="Pesquisar produto..." aria-label="Buscar produtos" autocomplete="off" />
        <div id="busca-sugestoes" class="busca-sugestoes oculto-tela"></div>
      </div>
    </div>

    <p class="hero-subtitulo">Compare modelos, veja o histórico de preço e escolha onde comprar mais barato — sem cadastro.</p>

    <div id="filtros-ativos" class="filtros-ativos"></div>

    <button type="button" id="btn-mais-filtros" class="btn-mais-filtros" aria-expanded="false" aria-controls="controles-avancados">
      🔍 Mais filtros
    </button>

    <div class="controles oculto-tela" id="controles-avancados">
      <select id="filtro-categoria" aria-label="Filtrar por categoria">
        <option value="">Todas as categorias</option>
        {categorias.map((c) => <option value={c}>{c}</option>)}
      </select>
      <select id="filtro-material" aria-label="Filtrar por material">
        <option value="">Todos os materiais</option>
        {materiais.map((m) => <option value={m}>{m}</option>)}
      </select>
      <select id="ordenar" aria-label="Ordenar produtos">
        <option value="">Ordenar: padrão</option>
        <option value="preco_asc">Menor preço</option>
        <option value="preco_desc">Maior preço</option>
        <option value="cliques">Mais clicados</option>
        <option value="recentes">Mais recentes</option>
      </select>
      <div class="filtro-preco-linha">
        <input type="number" id="filtro-preco-min" placeholder="Preço mín." min="0" step="0.01" aria-label="Preço mínimo" />
        <span aria-hidden="true">—</span>
        <input type="number" id="filtro-preco-max" placeholder="Preço máx." min="0" step="0.01" aria-label="Preço máximo" />
      </div>
      <label class="filtro-pix-linha">
        <input type="checkbox" id="filtro-pix" />
        Só com desconto no Pix
      </label>
    </div>
  </section>

  <FaixaProvaSocial totalProdutos={produtos.length} totalLojas={totalLojas} />

  {secoes.map(({ secao, produtos: produtosDaSecao, temMais }) => (
    <SecaoHome secao={secao} produtos={produtosDaSecao} temMais={temMais} badgesPorId={badgesPorId} />
  ))}

  <div class="titulo-secao-grid-linha">
    <h2 class="titulo-secao-grid">Últimas Ofertas!</h2>
  </div>

  <main id="grid" class="grid" style={`--colunas-grid: ${colunasGrid}`}>
    {produtos.map((p) => (
      <ProductCard
        p={p}
        menorPreco={badgesPorId.get(p.id)?.menorPreco}
        produtoNovo={badgesPorId.get(p.id)?.produtoNovo}
        precoAnterior={badgesPorId.get(p.id)?.precoAnterior}
      />
    ))}
  </main>

  <div class="ver-mais-container">
    <button id="btn-ver-mais" class="btn-ver-mais oculto-tela">Ver mais!</button>
  </div>

  <Footer />

  <BarraComparacao />

  <script is:inline src="/js/config.js"></script>
  <script is:inline src="/js/favoritos.js"></script>
  <script is:inline src="/js/interativo.js"></script>
</body>
</html>
