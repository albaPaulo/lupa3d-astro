---
import ProductCard from "../../components/ProductCard.astro";
import IconeFilamento from "../../components/IconeFilamento.astro";
import IconeResina from "../../components/IconeResina.astro";
import BarraComparacao from "../../components/BarraComparacao.astro";
import Footer from "../../components/Footer.astro";
import GlobalStyles from "../../components/GlobalStyles.astro";
import {
  fetchProdutos,
  fetchLojas,
  fetchHistoricoTodos,
  fetchConfiguracoes,
  buildHistoricoPorProduto,
  materialEfetivo,
  REDES_LOJA,
  EMOJI_CATEGORIA,
  LABEL_CATEGORIA,
} from "../../lib/supabase.js";
import { badgesMenorPrecoDeConfig, badgesProdutoNovoDeConfig, badgeMenorPrecoEfetivo, badgeProdutoNovo, precoAnteriorParaExibicao } from "../../lib/badges.js";

export async function getStaticPaths() {
  const [produtos, lojasConfig, historicoTodos, config] = await Promise.all([
    fetchProdutos(),
    fetchLojas(),
    fetchHistoricoTodos(),
    fetchConfiguracoes(),
  ]);
  const nomes = [...new Set(produtos.map((p) => p.loja))];
  const historicoPorProduto = buildHistoricoPorProduto(historicoTodos);
  const badgesMenorPreco = badgesMenorPrecoDeConfig(config);
  const badgesProdutoNovo = badgesProdutoNovoDeConfig(config);
  const historicoAtivo = config.menor_preco_historico_ativo !== "false";
  const colunasGrid = Math.min(6, Math.max(2, parseInt(config.colunas_grid, 10) || 3));

  return nomes.map((nome) => {
    const produtosDaLoja = produtos.filter((p) => p.loja === nome);

    // Em quais categorias cada material aparece de verdade nessa loja — usado
    // pra esconder tag de material que não faz sentido na categoria
    // selecionada (ex: "Dental" some quando o filtro é "Filamento").
    const categoriasPorMaterialMap = new Map();
    for (const p of produtosDaLoja) {
      const m = materialEfetivo(p);
      if (!m || !p.categoria) continue;
      if (!categoriasPorMaterialMap.has(m)) categoriasPorMaterialMap.set(m, new Set());
      categoriasPorMaterialMap.get(m).add(p.categoria);
    }
    const categoriasPorMaterial = Object.fromEntries(
      [...categoriasPorMaterialMap].map(([m, categoriasSet]) => [m, [...categoriasSet]])
    );

    return {
      params: { nome },
      props: {
        nome,
        produtosDaLoja,
        colunasGrid,
        loja: lojasConfig.find((l) => l.nome === nome) || null,
        categorias: [...new Set(produtosDaLoja.map((p) => p.categoria).filter(Boolean))].sort(),
        materiais: [...new Set(produtosDaLoja.map(materialEfetivo).filter(Boolean))].sort(),
        categoriasPorMaterial,
        badges: produtosDaLoja.map((p) => ({
          id: p.id,
          menorPreco: badgeMenorPrecoEfetivo(p, badgesMenorPreco, historicoPorProduto, historicoAtivo),
          produtoNovo: badgeProdutoNovo(p, badgesProdutoNovo),
          precoAnterior: precoAnteriorParaExibicao(p, historicoPorProduto),
        })),
      },
    };
  });
}

const { nome, produtosDaLoja, loja, categorias, materiais, categoriasPorMaterial, badges, colunasGrid } = Astro.props;
const badgesPorId = new Map(badges.map((b) => [b.id, b]));
const titulo = `${nome} — LUPA3D`;
const descricao = loja?.descricao || `Confira os ${produtosDaLoja.length} produtos e preços da ${nome} no LUPA3D.`;
const redes = REDES_LOJA.filter((r) => loja?.[r.chave]);

const qtdComPix = produtosDaLoja.filter((p) => p.preco_pix != null && Number(p.preco_pix) < Number(p.preco)).length;
const percentualPix = qtdComPix > 0 ? Math.round((qtdComPix / produtosDaLoja.length) * 100) : 0;

// Loja com mais de uma unidade física guarda vários estados separados por
// vírgula (ex: "SP, RJ") — mesmo critério usado em /lojas/.
const ufsLoja = (loja?.estado || "").split(",").map((uf) => uf.trim().toUpperCase()).filter(Boolean);
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={`https://lupa3d.com.br/loja/${nome}/`} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="LUPA3D" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  {loja?.logo_url && <meta property="og:image" content={loja.logo_url} />}
  <meta name="twitter:card" content="summary_large_image" />

  <GlobalStyles />
</head>
<body>
  <div id="banner-aviso" class="banner-aviso oculto-tela"></div>

  <header class="topo">
    <div class="topo-linha">
      <a href="/" class="logo-lupa3d">LUPA<span>3D</span></a>
      <nav class="abas">
        <a href="/">&larr; Início</a>
        <a href="/ofertas/">🔥 Ofertas</a>
        <a href="/lojas/">🏬 Lojas</a>
        <a href="/favoritos/">♡ Favoritos (<span data-contador-favoritos>0</span>)</a>
      </nav>
    </div>
  </header>

  <section class="loja-perfil">
    {loja?.banner_url && (
      <div class="loja-perfil-banner" style={`background-image:url("${loja.banner_url}")`}></div>
    )}
    <div class="loja-perfil-cabecalho">
      <div class="loja-perfil-logo-wrap">
        {loja?.logo_url && <img src={loja.logo_url} class="loja-perfil-logo" alt="" referrerpolicy="no-referrer" />}
      </div>
      <h1 class="loja-perfil-nome">{nome}</h1>
    </div>
    <div class="loja-perfil-resumo">
      <span class="loja-card-qtd">{produtosDaLoja.length} produto{produtosDaLoja.length === 1 ? "" : "s"}</span>
      {percentualPix > 0 && <span class="loja-card-pix">🟢 {percentualPix}% com desconto Pix</span>}
      {ufsLoja.length > 0 && <span class="loja-card-estado">📍 {ufsLoja.join(", ")}</span>}
    </div>
    {loja?.descricao && <p class="loja-perfil-descricao">{loja.descricao}</p>}
    {redes.length > 0 && (
      <div class="loja-perfil-redes">
        {redes.map((r) => (
          <a href={loja[r.chave]} target="_blank" rel="noopener" class="loja-perfil-rede-btn">{r.emoji} {r.label}</a>
        ))}
      </div>
    )}
  </section>

  <section class="barra-busca-categoria">
    {categorias.length > 1 && (
      <nav class="atalhos-categoria" aria-label="Atalhos de categoria">
        {categorias.map((c) => (
          <button type="button" class="atalho-categoria" data-categoria={c}>
            <span class="atalho-categoria-icone" aria-hidden="true">{EMOJI_CATEGORIA[c] || "📦"}</span>
            <span class="atalho-categoria-label">{LABEL_CATEGORIA[c] || c}</span>
          </button>
        ))}
      </nav>
    )}

    <div class="busca-solo">
      <div class="busca-grande">
        <span class="busca-icone" aria-hidden="true">🔍</span>
        <input type="search" id="busca" placeholder={`Pesquisar produto na ${nome}...`} aria-label="Buscar produtos nesta loja" autocomplete="off" />
        <div id="busca-sugestoes" class="busca-sugestoes oculto-tela"></div>
      </div>
    </div>

    {materiais.length > 0 && (
      <div class="tags-material" aria-label="Filtrar por material">
        {materiais.map((m) => (
          <button type="button" class="tag-material" data-material={m} data-categorias={(categoriasPorMaterial[m] || []).join(",")}>
            {(categoriasPorMaterial[m] || []).includes("filamento") && <IconeFilamento id={m} class="icone-filamento" />}
            {(categoriasPorMaterial[m] || []).includes("resina") && <IconeResina id={m} class="icone-resina" />}
            {m}
          </button>
        ))}
      </div>
    )}

    <div id="descricao-material" class="descricao-material oculto-tela" aria-live="polite"></div>

    <div id="filtros-ativos" class="filtros-ativos"></div>

    <div class="controles" id="controles-avancados">
      <select id="filtro-categoria" aria-label="Filtrar por categoria">
        <option value="">Todas as categorias</option>
        {categorias.map((c) => <option value={c}>{c}</option>)}
      </select>
      <select id="filtro-material" aria-label="Filtrar por material">
        <option value="">Todos os materiais</option>
        {materiais.map((m) => <option value={m}>{m}</option>)}
      </select>
      <select id="ordenar" aria-label="Ordenar produtos">
        <option value="">Ordenar: padrão</option>
        <option value="preco_asc">Menor preço</option>
        <option value="preco_desc">Maior preço</option>
        <option value="cliques">Mais clicados</option>
        <option value="recentes">Mais recentes</option>
      </select>
      <div class="filtro-preco-linha">
        <input type="number" id="filtro-preco-max" placeholder="Preço máx." min="0" step="0.01" aria-label="Preço máximo" />
      </div>
      <label class="filtro-pix-linha">
        <input type="checkbox" id="filtro-pix" />
        Só com desconto no Pix
      </label>
    </div>
  </section>

  <div class="titulo-secao-grid-linha">
    <h2 class="titulo-secao-grid">Produtos ({produtosDaLoja.length})</h2>
  </div>

  <main id="grid" class="grid" style={`--colunas-grid: ${colunasGrid}`}>
    {produtosDaLoja.map((p) => (
      <ProductCard
        p={p}
        menorPreco={badgesPorId.get(p.id)?.menorPreco}
        produtoNovo={badgesPorId.get(p.id)?.produtoNovo}
        precoAnterior={badgesPorId.get(p.id)?.precoAnterior}
      />
    ))}
  </main>

  <div class="ver-mais-container">
    <button id="btn-ver-mais" class="btn-ver-mais oculto-tela">Ver mais!</button>
  </div>

  <Footer />

  <BarraComparacao />

  <script is:inline defer src="/js/config.js"></script>
  <script is:inline defer src="/js/favoritos.js"></script>
  <script is:inline defer src="/js/interativo.js"></script>
</body>
</html>
