---
import BarraComparacao from "../../components/BarraComparacao.astro";
import ParecidoItem from "../../components/ParecidoItem.astro";
import ProductCard from "../../components/ProductCard.astro";
import Footer from "../../components/Footer.astro";
import GlobalStyles from "../../components/GlobalStyles.astro";
import {
  fetchProdutos,
  fetchLojas,
  fetchHistoricoTodos,
  fetchConfiguracoes,
  buildHistoricoPorProduto,
  produtosParecidos,
  formatarPreco,
  LABEL_CATEGORIA,
  materialEfetivo,
  otimizarImagem,
} from "../../lib/supabase.js";
import { badgesMenorPrecoDeConfig, badgesProdutoNovoDeConfig, badgeMenorPrecoEfetivo, badgeProdutoNovo, precoAnteriorParaExibicao } from "../../lib/badges.js";
import { desenharGraficoSVG } from "../../lib/grafico.js";
import { linksCompartilhar } from "../../lib/compartilhar.js";

export async function getStaticPaths() {
  const [produtos, lojasConfig, historicoTodos, config] = await Promise.all([
    fetchProdutos(),
    fetchLojas(),
    fetchHistoricoTodos(),
    fetchConfiguracoes(),
  ]);

  const historicoPorProduto = buildHistoricoPorProduto(historicoTodos);
  const badgesMenorPreco = badgesMenorPrecoDeConfig(config);
  const badgesProdutoNovo = badgesProdutoNovoDeConfig(config);
  const historicoAtivo = config.menor_preco_historico_ativo !== "false";
  const faixaPrecoAtiva = config.parecidos_faixa_preco_ativa === "true";

  return produtos.map((p) => {
    const parecidos = produtosParecidos(produtos, p, faixaPrecoAtiva);
    // Seção de navegação/descoberta, separada dos "parecidos" (que são pra
    // comparar preço do MESMO material em outras lojas) — aqui é qualquer
    // produto da mesma categoria, material diferente incluso, pra incentivar
    // continuar explorando o catálogo. Exclui o próprio produto e quem já
    // apareceu em parecidos, pra não repetir card.
    const idsExcluidos = new Set([p.id, ...parecidos.map((item) => item.id)]);
    const maisDaCategoria = produtos
      .filter((outro) => outro.categoria === p.categoria && !idsExcluidos.has(outro.id))
      .sort((a, b) => (b.cliques_total || 0) - (a.cliques_total || 0))
      .slice(0, 5);

    return {
      params: { id: String(p.id) },
      props: {
        produto: p,
        loja: lojasConfig.find((l) => l.nome === p.loja) || null,
        historico: historicoPorProduto.get(p.id) || [],
        parecidos,
        maisDaCategoria,
        menorPreco: badgeMenorPrecoEfetivo(p, badgesMenorPreco, historicoPorProduto, historicoAtivo),
        produtoNovo: badgeProdutoNovo(p, badgesProdutoNovo),
        precoAnterior: precoAnteriorParaExibicao(p, historicoPorProduto),
      },
    };
  });
}

const { produto: p, loja, historico, parecidos, maisDaCategoria, menorPreco, produtoNovo, precoAnterior } = Astro.props;
const categoriaLabel = LABEL_CATEGORIA[p.categoria] || p.categoria;
// "parecidos" já é filtrado por mesma categoria + mesmo material (quando
// detectado) em produtosParecidos() — o título reflete exatamente esse
// filtro, tipo "Resina Lavável à Água em outras lojas", em vez do genérico
// "Produtos parecidos" de antes.
const tituloParecidos = `${categoriaLabel}${materialEfetivo(p) ? ` ${materialEfetivo(p)}` : ""} em outras lojas`;
const titulo = `${p.nome} — LUPA3D`;
const descricao = `${p.nome} por ${formatarPreco(p.preco)} na ${p.loja}. Compare com outras lojas de filamento e resina 3D no LUPA3D.`;

// Descrição do produto (não a meta description acima) limitada em
// caracteres — a coluna esquerda (imagem + descrição) e a direita
// (vendido por + histórico + parecidos, agora sem limite de altura) não
// têm a mesma altura no grid; uma descrição sem limite podia esticar
// demais a coluna esquerda e desequilibrar o layout com a direita.
const DESCRICAO_LIMITE = 400;
function truncarTexto(texto, limite) {
  if (!texto || texto.length <= limite) return texto;
  const cortado = texto.slice(0, limite);
  const ultimoEspaco = cortado.lastIndexOf(" ");
  return `${cortado.slice(0, ultimoEspaco > 0 ? ultimoEspaco : limite)}…`;
}
// null (não texto de fallback) quando não há descrição real — a caixa de
// imagem some com o bloco de descrição inteiro nesse caso, em vez de
// mostrar uma caixa "Sem descrição disponível" praticamente vazia.
const descricaoProduto = truncarTexto(p.descricao_manual || p.descricao, DESCRICAO_LIMITE) || null;
const graficoSVG = desenharGraficoSVG(historico);
const precoMaximoHistorico = historico.length > 0 ? Math.max(...historico.map((h) => h.preco)) : null;
const quedaPercentual = precoMaximoHistorico && precoMaximoHistorico > p.preco
  ? Math.round(((precoMaximoHistorico - p.preco) / precoMaximoHistorico) * 100)
  : null;
const economiaValor = precoMaximoHistorico && precoMaximoHistorico > p.preco
  ? precoMaximoHistorico - p.preco
  : null;
const descontoPercentual = precoAnterior && precoAnterior > p.preco
  ? Math.round(((precoAnterior - p.preco) / precoAnterior) * 100)
  : null;

const urlProduto = `https://lupa3d.com.br/produto/${p.id}/`;
const textoCompartilhar = `${p.nome} por ${formatarPreco(p.preco)} — comparei no LUPA3D`;
const linksCompartilharProduto = linksCompartilhar(urlProduto, textoCompartilhar);

// Dados estruturados (schema.org) pra o Google poder mostrar preço/loja
// direto no resultado de busca. Sem AggregateRating/Review — não temos
// avaliação real nenhuma, e declarar isso sem dado de verdade viola as
// diretrizes do Google (e pode gerar penalização manual).
// priceValidUntil: o scraper roda 1x/dia, então declara validade de só 2
// dias a partir do build (com folga pra atraso de build/rebuild) — nunca
// promete um preço "válido" além do que realmente conseguimos garantir.
const precoValidoAte = new Date(Date.now() + 2 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
const produtoJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: p.nome,
  image: p.imagem_url || undefined,
  description: p.descricao_manual || p.descricao || undefined,
  offers: {
    "@type": "Offer",
    url: p.url,
    priceCurrency: "BRL",
    price: Number(p.preco).toFixed(2),
    priceValidUntil: precoValidoAte,
    availability: p.disponivel ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    seller: { "@type": "Organization", name: p.loja },
  },
};
const produtoJsonLdString = JSON.stringify(produtoJsonLd).replace(/</g, "\\u003c");

// Breadcrumb estruturado — a trilha visual já existe na página (Início ›
// categoria › loja › produto), isso só expõe a mesma hierarquia como
// JSON-LD pro Google poder mostrar a trilha direto no resultado de busca.
// A categoria entra com link pra /categoria/ mesmo não sendo clicável na
// trilha visual hoje, porque a página de destino existe e é válida.
const breadcrumbItens = [
  { "@type": "ListItem", position: 1, name: "Início", item: "https://lupa3d.com.br/" },
  ...(p.categoria
    ? [{ "@type": "ListItem", position: 2, name: categoriaLabel, item: `https://lupa3d.com.br/categoria/${p.categoria}/` }]
    : []),
  { "@type": "ListItem", position: p.categoria ? 3 : 2, name: p.loja, item: `https://lupa3d.com.br/loja/${p.loja}/` },
  { "@type": "ListItem", position: p.categoria ? 4 : 3, name: p.nome },
];
const breadcrumbJsonLd = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: breadcrumbItens };
const breadcrumbJsonLdString = JSON.stringify(breadcrumbJsonLd).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={urlProduto} />

  <meta property="og:type" content="product" />
  <meta property="og:site_name" content="LUPA3D" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  {p.imagem_url && <meta property="og:image" content={p.imagem_url} />}
  <meta name="twitter:card" content="summary_large_image" />

  <script type="application/ld+json" set:html={produtoJsonLdString}></script>
  <script type="application/ld+json" set:html={breadcrumbJsonLdString}></script>

  <GlobalStyles />
</head>
<body>
  <div id="banner-aviso" class="banner-aviso oculto-tela"></div>

  <header class="topo">
    <div class="topo-linha">
      <a class="logo-lupa3d" href="/">LUPA<span>3D</span></a>
      <a href="/" class="link-voltar">&larr; <span class="link-voltar-texto">Voltar para todos os produtos</span></a>
      <nav class="abas">
        <a href="/ofertas/">🔥 Ofertas</a>
        <a href="/favoritos/">♡ Favoritos (<span data-contador-favoritos>0</span>)</a>
      </nav>
    </div>
  </header>

  <main class="produto-pagina">
    <nav class="breadcrumb" aria-label="Navegação">
      <a href="/">Início</a>
      {p.categoria && <><span>›</span> <span>{p.categoria}</span></>}
      <span>›</span> <a href={`/loja/${p.loja}/`}>{p.loja}</a>
      <span>›</span> <span class="breadcrumb-atual">{p.nome}</span>
    </nav>

    <div class="produto-box produto-titulo-box">
      {produtoNovo && (
        <span class="badge-produto-novo-titulo">{produtoNovo.icone ? `${produtoNovo.icone} ` : ""}{produtoNovo.label || "Novo"}</span>
      )}
      <h1>{p.nome}</h1>
    </div>

    <div class="produto-grid">
      <div class="produto-col-esq">
        <div class="produto-box produto-imagem-box">
          <button class="btn-favorito" data-id={p.id} title="Favoritar" aria-label="Favoritar" aria-pressed="false">☆</button>
          <div class="detalhe-imagem">
            {p.imagem_url ? (
              <img src={otimizarImagem(p.imagem_url, 600)} alt={p.nome} referrerpolicy="no-referrer" />
            ) : (
              <span class="card-imagem-vazia">📦</span>
            )}
          </div>
          {descricaoProduto && (
            <div class="produto-imagem-descricao">
              <h2 class="produto-box-titulo">Descrição</h2>
              <p class="detalhe-descricao">{descricaoProduto}</p>
            </div>
          )}
        </div>
      </div>

      <div class="produto-col-dir">
        <div class="produto-linha-topo">
          <div class="produto-box produto-vendido-box">
            <h2 class="produto-box-titulo">Vendido por</h2>
            {loja?.logo_url && (
              <a href={`/loja/${p.loja}/`} class="produto-vendido-logo-link">
                <img src={loja.logo_url} alt={`Logotipo da ${p.loja}`} class="produto-vendido-logo" referrerpolicy="no-referrer" />
              </a>
            )}
            <span class="card-loja-nome-texto">{p.loja}</span>
            <a href={`/loja/${p.loja}/`} class="produto-vendido-ver-mais">Ver mais produtos</a>
            {menorPreco && (
              <span class="produto-vendido-menor-preco">{menorPreco.icone ? `${menorPreco.icone} ` : "👍 "}{menorPreco.label || `Menor preço em ${menorPreco.dias} dias`}</span>
            )}
            <div class="card-precos">
              {precoAnterior && (
                <div class="card-preco-linha-anterior">
                  <span class="card-preco-anterior">{formatarPreco(precoAnterior)}</span>
                  {descontoPercentual && <span class="card-desconto">-{descontoPercentual}%</span>}
                </div>
              )}
              <span class="card-preco">{formatarPreco(p.preco)}</span>
              {p.preco_pix != null && Number(p.preco_pix) < Number(p.preco) && <span class="card-preco-pix">{formatarPreco(p.preco_pix)} no Pix</span>}
            </div>
            {economiaValor != null && (
              <div class="produto-vendido-economia">
                <span class="produto-vendido-economia-icone" aria-hidden="true">🏆</span>
                <div>
                  <span class="produto-vendido-economia-titulo">Você está economizando</span>
                  <span class="produto-vendido-economia-valor">{formatarPreco(economiaValor)} em relação ao maior preço já registrado</span>
                </div>
              </div>
            )}
            <div class="card-acoes">
              <a href={p.url} target="_blank" rel={p.afiliado ? "noopener sponsored" : "noopener"} class="btn-ver-oferta">Ver Oferta!</a>
              <button type="button" class="btn-comparar-toggle" data-id={p.id} title="Comparar" aria-label="Comparar" aria-pressed="false">⇄</button>
            </div>
            {p.afiliado && (
              <p class="produto-aviso-afiliado">
                🔗 Este é um link de afiliado — comprar por ele pode gerar comissão pro LUPA3D, sem custo extra pra você.
              </p>
            )}

            <div class="produto-compartilhar">
              <span class="produto-compartilhar-label">Compartilhar:</span>
              {linksCompartilharProduto.map((l) => (
                <a href={l.url} target="_blank" rel="noopener" class="btn-compartilhar" aria-label={`Compartilhar no ${l.rede}`} title={l.rede} set:html={l.icone} />
              ))}
            </div>
          </div>

          <div class="produto-box produto-historico-box">
            <h2 class="produto-box-titulo"><span aria-hidden="true">📈</span> Histórico de preço</h2>
            {historico.length >= 2 && (
              <div class="historico-resumo">
                <div class="historico-resumo-atual">
                  <span class="historico-resumo-label">Preço atual</span>
                  <div class="historico-resumo-linha-valor">
                    <span class="historico-resumo-valor">{formatarPreco(p.preco)}</span>
                    {quedaPercentual != null && (
                      <span class="historico-resumo-queda">▼ {quedaPercentual}% de queda</span>
                    )}
                  </div>
                  {p.atualizado_em && (
                    <span class="historico-resumo-atualizado">Última atualização: {new Date(p.atualizado_em).toLocaleDateString("pt-BR")}</span>
                  )}
                </div>
              </div>
            )}
            <div id="grafico-container" set:html={graficoSVG}></div>

            <div class="produto-preco-alvo" data-id={p.id}>
              <button type="button" class="btn-preco-alvo-toggle">
                <span class="btn-preco-alvo-icone" aria-hidden="true">🔔</span>
                <span class="btn-preco-alvo-texto">Alerta de preço</span>
                <span class="btn-preco-alvo-seta" aria-hidden="true">›</span>
              </button>
              <div class="produto-preco-alvo-form oculto-tela">
                <input type="number" class="input-preco-alvo" min="0" step="0.01" placeholder="Ex: 89.90" aria-label="Preço-alvo" />
                <button type="button" class="btn-preco-alvo-salvar">Salvar</button>
              </div>
              <div class="produto-preco-alvo-ativo oculto-tela">
                <span class="produto-preco-alvo-texto"></span>
                <button type="button" class="btn-preco-alvo-remover" aria-label="Remover preço-alvo" title="Remover preço-alvo">✕</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="produto-box produto-parecidos-box">
      <h2 class="produto-box-titulo">{tituloParecidos}</h2>
      {parecidos.length === 0 ? (
        <p class="grafico-vazio">Nenhum produto parecido encontrado em outras lojas.</p>
      ) : (
        <div class="parecidos-lista">
          {parecidos.map((parecido) => <ParecidoItem p={parecido} />)}
        </div>
      )}
    </div>

    {maisDaCategoria.length > 0 && (
      <section class="produto-mais-categoria">
        <div class="titulo-secao-grid-linha">
          <h2 class="titulo-secao-grid">Continue explorando {categoriaLabel}</h2>
        </div>
        <div class="grid" style="--colunas-grid: 4">
          {maisDaCategoria.map((item) => <ProductCard p={item} />)}
        </div>
      </section>
    )}
  </main>

  <Footer />

  <BarraComparacao />

  <script is:inline defer src="/js/config.js"></script>
  <script is:inline defer src="/js/favoritos.js"></script>
  <script is:inline defer src="/js/interativo.js"></script>
</body>
</html>
