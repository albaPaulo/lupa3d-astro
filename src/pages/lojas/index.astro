---
import { fetchProdutos, fetchLojas } from "../../lib/supabase.js";
import Footer from "../../components/Footer.astro";

const [produtos, lojasConfig] = await Promise.all([fetchProdutos(), fetchLojas()]);

const contagemPorLoja = new Map();
for (const p of produtos) {
  contagemPorLoja.set(p.loja, (contagemPorLoja.get(p.loja) || 0) + 1);
}
const nomesLojas = [...contagemPorLoja.keys()].sort();
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Lojas — LUPA3D</title>
  <meta name="description" content="Veja todas as lojas de filamento e resina 3D comparadas no LUPA3D." />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="topo">
    <div class="topo-linha">
      <a class="logo-lupa3d" href="/">LUPA<span>3D</span></a>
      <a href="/" class="link-voltar">&larr; Voltar para todos os produtos</a>
    </div>
  </header>

  <main class="lojas-pagina">
    <h1 class="lojas-titulo">Lojas</h1>
    <div class="lojas-grid">
      {nomesLojas.map((nome) => {
        const cfg = lojasConfig.find((l) => l.nome === nome);
        const qtd = contagemPorLoja.get(nome);
        return (
          <a href={`/loja/${nome}/`} class="loja-card">
            <div class="loja-card-logo-wrap">
              {cfg?.logo_url ? (
                <img src={cfg.logo_url} alt="" class="loja-card-logo" referrerpolicy="no-referrer" />
              ) : (
                <span class="loja-card-logo-inicial">{nome[0].toUpperCase()}</span>
              )}
            </div>
            <span class="loja-card-nome">{nome}</span>
            <span class="loja-card-qtd">{qtd} produto{qtd === 1 ? "" : "s"}</span>
          </a>
        );
      })}
    </div>
  </main>

  <Footer />
</body>
</html>
