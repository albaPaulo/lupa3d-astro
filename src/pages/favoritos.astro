---
import BarraComparacao from "../components/BarraComparacao.astro";
import Footer from "../components/Footer.astro";
import GlobalStyles from "../components/GlobalStyles.astro";
import { ICONES_COMPARTILHAR } from "../lib/compartilhar.js";

// Os ícones em si são estáticos (não dependem de dado nenhum), mas a URL de
// cada rede depende de quem está favoritado — só existe no navegador de
// quem está vendo a página. Renderiza os ícones aqui (build) com href
// provisório; favoritos-pagina.js preenche o href de verdade no cliente.
const redesCompartilhar = Object.entries(ICONES_COMPARTILHAR).map(([rede, icone]) => ({ rede, icone }));
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, follow" />
  <title>Favoritos — LUPA3D</title>
  <meta name="description" content="Seus produtos favoritos no LUPA3D." />
  <GlobalStyles />
</head>
<body>
  <div id="banner-aviso" class="banner-aviso oculto-tela"></div>

  <header class="topo">
    <div class="topo-linha">
      <a href="/" class="logo-lupa3d">LUPA<span>3D</span></a>
      <div class="busca-grande">
        <span class="busca-icone" aria-hidden="true">🔍</span>
        <input type="search" id="busca" placeholder="Pesquisar nos favoritos..." aria-label="Buscar nos favoritos" autocomplete="off" />
        <div id="busca-sugestoes" class="busca-sugestoes oculto-tela"></div>
      </div>
      <nav class="abas">
        <a href="/">&larr; Início</a>
        <a href="/ofertas/">🔥 Ofertas</a>
        <a href="/lojas/">🏬 Lojas</a>
      </nav>
    </div>
    <div id="filtros-ativos" class="filtros-ativos"></div>
    <div class="controles">
      <select id="filtro-categoria" aria-label="Filtrar por categoria">
        <option value="">Todas as categorias</option>
      </select>
      <select id="filtro-material" aria-label="Filtrar por material">
        <option value="">Todos os materiais</option>
      </select>
      <select id="ordenar" aria-label="Ordenar produtos">
        <option value="">Ordenar: padrão</option>
        <option value="preco_asc">Menor preço</option>
        <option value="preco_desc">Maior preço</option>
        <option value="cliques">Mais clicados</option>
        <option value="recentes">Mais recentes</option>
      </select>
      <label class="filtro-pix-linha">
        <input type="checkbox" id="filtro-pix" />
        Só com desconto no Pix
      </label>
    </div>
  </header>


  <div class="titulo-secao-grid-linha">
    <h1 class="titulo-secao-grid">Favoritos</h1>
    <div id="favoritos-compartilhar" class="produto-compartilhar oculto-tela">
      <span class="produto-compartilhar-label">Compartilhar:</span>
      {redesCompartilhar.map((r) => (
        <a href="#" data-rede={r.rede} target="_blank" rel="noopener" class="btn-compartilhar" aria-label={`Compartilhar no ${r.rede}`} title={r.rede} set:html={r.icone} />
      ))}
      <button type="button" id="btn-compartilhar-favoritos" class="btn-compartilhar" aria-label="Copiar link" title="Copiar link">🔗</button>
    </div>
  </div>

  <div id="favoritos-alerta-alvo" class="favoritos-alerta-queda favoritos-alerta-alvo oculto-tela"></div>
  <div id="favoritos-alerta-queda" class="favoritos-alerta-queda oculto-tela"></div>

  <p id="status" class="status-carregando">Carregando favoritos...</p>
  <main id="grid" class="grid"></main>

  <div class="ver-mais-container">
    <button id="btn-ver-mais" class="btn-ver-mais oculto-tela">Ver mais!</button>
  </div>

  <Footer />

  <BarraComparacao />

  <script is:inline defer src="/js/config.js"></script>
  <script is:inline defer src="/js/favoritos.js"></script>
  <script is:inline defer src="/js/interativo.js"></script>
  <script is:inline defer src="/js/favoritos-pagina.js"></script>
</body>
</html>
